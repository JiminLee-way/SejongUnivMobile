<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 백업·디바이스 이전 시 앱 데이터 추출 금지.
     포함하는 데이터 : flutter_secure_storage(키체인), PersistCookieJar(refresh token),
     Hive/JSON 캐시(시간표). 모두 학번·인증 정보가 들어있어 차단해야 함. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
