<?xml version="1.0" encoding="utf-8"?>
<!-- UCHECK_API_BASE_URL may be cleartext in internal builds. The actual host is
     supplied outside the public source tree. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
